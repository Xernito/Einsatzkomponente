<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
    <name>com_einsatzkomponente</name>
    <creationDate>2026-11</creationDate>
    <copyright>Copyright (C) 2020 by Ralf Meyer. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later</license>
    <author>Ralf Meyer</author>
    <authorEmail>ralf.meyer@mail.de</authorEmail>
    <authorUrl>https://einsatzkomponente.de</authorUrl>
    <version>5.0.0</version>

    <description>
            <![CDATA[
			<h1>Einsatzkomponente</h1><h3>für das Joomla-CMS</h3>
			<div style="clear: both;"></div>
			<p>Copyright (C) 2020 Ralf Meyer</p>
			<p>Website: <a href='https://www.einsatzkomponente.de'>www.einsatzkomponente.de</a></p>
			]]>
	</description>

    <namespace path="src">Einsatzkomponente\Component\Einsatzkomponente</namespace>

    <scriptfile>script.php</scriptfile>

    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>

    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
        </sql>
    </uninstall>

    <update>
        <schemas>
            <schemapath type="mysql">sql/updates/mysql</schemapath>
        </schemas>
    </update>

    <files folder="site">
        <folder>forms</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>

    <media destination="com_einsatzkomponente" folder="media">
        <filename>joomla.asset.json</filename>
        <folder>admin</folder>
        <folder>css</folder>
        <folder>einsatzbilder</folder>
        <folder>highslide</folder>
        <folder>images</folder>
        <folder>js</folder>
        <folder>leaflet</folder>
        <folder>osm</folder>
        <folder>pdf</folder>
        <folder>watermark</folder>
    </media>

    <administration>
        <menu img="class:fire-extinguisher">COM_EINSATZKOMPONENTE_MENU</menu>
        <submenu>
            <menu link="option=com_einsatzkomponente&amp;view=kontrollcenter" view="kontrollcenter" img="class:home" alt="Einsatzkomponente/Kontrollcenter">COM_EINSATZKOMPONENTE_TITLE_KONTROLLCENTER</menu>
            <menu link="option=com_einsatzkomponente&amp;view=einsatzberichte" view="einsatzberichte" img="class:file-alt" alt="Einsatzkomponente/Einsatzberichte">COM_EINSATZKOMPONENTE_TITLE_EINSATZBERICHTE</menu>
            <menu link="option=com_einsatzkomponente&amp;view=kategorien" view="kategorien" img="class:folder" alt="Einsatzkomponente/Kategorien">COM_EINSATZKOMPONENTE_TITLE_KATEGORIEN</menu>
            <menu link="option=com_einsatzkomponente&amp;view=einsatzarten" view="einsatzarten" img="class:tags" alt="Einsatzkomponente/Einsatzarten">COM_EINSATZKOMPONENTE_TITLE_EINSATZARTEN</menu>
            <menu link="option=com_einsatzkomponente&amp;view=alarmierungsarten" view="alarmierungsarten" img="class:bell" alt="Einsatzkomponente/Alarmierungsarten">COM_EINSATZKOMPONENTE_TITLE_ALARMIERUNGSARTEN</menu>
            <menu link="option=com_einsatzkomponente&amp;view=einsatzfahrzeuge" view="einsatzfahrzeuge" img="class:truck" alt="Einsatzkomponente/Einsatzfahrzeuge">COM_EINSATZKOMPONENTE_TITLE_EINSATZFAHRZEUGE</menu>
            <menu link="option=com_einsatzkomponente&amp;view=organisationen" view="organisationen" img="class:sitemap" alt="Einsatzkomponente/Organisationen">COM_EINSATZKOMPONENTE_TITLE_ORGANISATIONEN</menu>
            <menu link="option=com_einsatzkomponente&amp;view=einsatzbildmanager" view="einsatzbildmanager" img="class:images" alt="Einsatzkomponente/Einsatzbildmanager">COM_EINSATZKOMPONENTE_TITLE_EINSATZBILDMANAGER</menu>
            <menu link="option=com_einsatzkomponente&amp;view=gmapkonfigurationen" view="gmapkonfigurationen" img="class:map" alt="Einsatzkomponente/Gmapkonfigurationen">COM_EINSATZKOMPONENTE_TITLE_GMAPKONFIGURATIONEN</menu>
        </submenu>

        <files folder="administrator">
            <filename>access.xml</filename>
            <filename>config.xml</filename>
            <filename>CHANGELOG.php</filename>
            <folder>forms</folder>
            <folder>helpers</folder>
            <folder>services</folder>
            <folder>sql</folder>
            <folder>src</folder>
            <folder>tmpl</folder>
        </files>

        <languages folder="administrator">
            <language tag="de-DE">language/de-DE.com_einsatzkomponente.ini</language>
            <language tag="de-DE">language/de-DE.com_einsatzkomponente.sys.ini</language>
            <language tag="en-GB">language/en-GB.com_einsatzkomponente.ini</language>
            <language tag="en-GB">language/en-GB.com_einsatzkomponente.sys.ini</language>
        </languages>
    </administration>
</extension>
